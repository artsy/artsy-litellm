{
  "extends": ["@artsy:app"],
  "enabledManagers": ["dockerfile"],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/berriai/litellm"],
      "versioning": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
      "schedule": ["before 9am on monday"],
      "automerge": false
    }
  ]
}
